############################################################
#  Traefik Environment Variables
############################################################

# VERSION -- Tag of image version to use
# Note: Prevents accidental update when new release appears on registry
# Format: v1.2.3
# Default: v3.6.1
# Optional
VERSION = 

# CF_API_EMAIL -- Cloudflare account email used for Let's Encrypt DNS challenge
# Note: Must match Cloudflare account associated with DNS zone
# Format: email
# Required
CF_API_EMAIL = 

# CF_DNS_API_TOKEN -- Cloudflare API token for DNS challenge automation
# Note: Requires DNS edit permissions for target zone
# Sensitive
# Format: API token
# Required
CF_DNS_API_TOKEN = 

# CF_API_PROVIDER -- DNS provider name used by Traefik ACME DNS challenge
# Example: cloudflare
# Format: provider identifier
# Required
CF_API_PROVIDER = 

# PUBLIC_DOMAIN -- Public domain for user access
# Note: Used in Traefik labels (router rules)
# Format: your.domain.com
# Required
PUBLIC_DOMAIN = 