############################################################
#  Speedtest Environment Variables
############################################################

# VERSION -- Tag of image version to use
# Note: Prevents accidental update when new release appears on registry
# Format: v1.2.3
# Default: v2.0.6
# Optional
VERSION = 

# PUBLIC_DOMAIN -- Public domain for user access
# Note: Used in Traefik labels (router rules)
# Format: your.domain.com
# Required
PUBLIC_DOMAIN = 

# AUTH_URI -- Authentik forward-auth endpoint URL used by Traefik middleware
# Note: Requests are validated through this endpoint before access is granted
# Example: https://auth.your.domain.com/outpost.goauthentik.io/auth/traefik
# Format: URL
# Required
AUTH_URI = 