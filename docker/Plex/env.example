############################################################
# Plex Environment Variables
############################################################

# ──────────────── Basics ────────────────
# TZ -- System timezone, duh
# Format: Region/City
# Required
TZ=

# PUID -- User ID for NFS connection
# Format: int
# Default: 0
# Optional
PUID=

# PGID -- User group ID for NFS connection
# Format: int
# Default: 0
# Optional
PGID=

# VERSION -- Tag of image version to use
# Note: Prevents accidental update when new release appears on registry
# Format: 1.42.2.10156-f737b826c | latest
# Default: 1.42.2.10156-f737b826c
# Optional
VERSION=

# PLEX_CLAIM -- Claim token to link server to Plex account
# Note: Can be safely removed once Plex web configuration complete
# Get from: https://account.plex.tv/claim
# Format: claim-xxxxxxxxxxxxxxxxxxxx
# Required for first start
PLEX_CLAIM=

# ──────────────── Networking ────────────────
# ALLOWED_NETWORKS — Defines local IP ranges that Plex treats as "home network"
# Format: comma-separated list of IPs or CIDR ranges without spaces
# Example: 192.168.1.20,10.0.0.0/16
# Optional
ALLOWED_NETWORKS=

# PUBLIC_DOMAIN -- Public domain for user access
# Note: Used in Traefik labels (router rules)
# Format: your.domain.com
# Required
PUBLIC_DOMAIN=

# ──────────────── NVIDIA GPU Support ────────────────
# NVIDIA_VISIBLE_DEVICES — Which GPU(s) to pass to Plex container
# Format: 'all' for all GPUs, or PCI ID like 'GPU-f342beks'
# Default: all
# Optional
NVIDIA_VISIBLE_DEVICES=

# NVIDIA_DRIVER_CAPABILITIES — GPU features exposed to Plex
# Note: 'video' is required for NVENC/NVDEC hardware transcoding
# Default: compute,video,utility
# Optional
NVIDIA_DRIVER_CAPABILITIES=compute,video,utility

# ──────────────── Storage ────────────────
# SSD_IMPORTANT_DATA_DIR -- Root directory on fast storage (SSD/NVMe) for important data
# Note: Used for service data requiring high I/O performance and replication
# Default: ./plex
# Required
SSD_IMPORTANT_DATA_DIR=

# SSD_DISPENSABLE_DATA_DIR -- Root directory on fast storage (SSD/NVMe) for dispensable data
# Note: Used for service data requiring high I/O performance, but not requiring replication
# Default: ./plex
# Required
SSD_DISPENSABLE_DATA_DIR=

# HDD_IMPORTANT_DATA_DIR -- Root directory on large-capacity storage (HDD/NAS)
# Note: Used for service data that require replication and is large in size but not performance-critical
# Optional
HDD_IMPORTANT_DATA_DIR=

# HDD_DISPENSABLE_DATA_DIR -- Root directory on large-capacity storage (HDD/NAS)
# Note: Used for service data that don't require replication and is large in size but not performance-critical
# Default: ./plex
# Required
HDD_DISPENSABLE_DATA_DIR=
