############################################################
#  N8N Environment Variables
############################################################

# ──────────────── Basics ────────────────
# TZ -- System timezone, duh
# Format: Region/City
# Required
TZ=

# PUID -- User ID for NFS connection
# Format: int
# Default: 1000
# Optional
PUID=

# PGID -- User group ID for NFS connection
# Format: int
# Default: 1000
# Optional
PGID=

# VERSION -- Tag of image version to use
# Note: Prevents accidental updates when new releases appear
# Format: nightly | latest | custom tag
# Default: nightly
# Optional
VERSION=

# ──────────────── Networking ────────────────
# PUBLIC_DOMAIN -- Public domain for user access
# Note: Used in Traefik labels (router rules)
# Format: your.domain.com
# Required
PUBLIC_DOMAIN=

# ──────────────── Storage ────────────────
# SSD_SERVICE_ROOT_DIR -- Root directory on fast storage (SSD/NVMe)
# Note: Used for service data requiring high I/O performance
# such as cache, thumbnails, transcode, model cache, and other
# frequently accessed small files.
# Default: ./n8n
# Optional
SSD_SERVICE_ROOT_DIR=

# n8n application port inside container
# Used by Traefik load balancer and Docker expose
# Format: int
# Default: 8678
# Optional
N8N_PORT=

# Encryption key used for credentials and sensitive data inside n8n
# MUST stay persistent between restarts/backups
# Losing this key means losing access to encrypted credentials
# Example: generated random 32+ char string
# Format: string
# Required
N8N_ENCRYPTION_KEY=

# Enforce strict permissions on n8n configuration files
# Recommended for security
# true = enforce permissions checks
# false = disable checks
# Format: boolean
# Default: true
# Optional
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true

# Protocol used for generated URLs and webhook callbacks
# Example: https
# Format: http|https
# Default: http
# Optional
N8N_PROTOCOL=

# Runtime environment mode
# production = optimized production behavior
# development = debug/development behavior
# Format: production|development
# Default: production
# Optional
NODE_ENV=

# Number of reverse proxies between client and n8n
# Required when running behind Traefik/Nginx/etc
# Example: 1
# Format: int
# Default: 0
# Optional
N8N_PROXY_HOPS=

# Database backend type
# Example: postgresdb
# Format: sqlite|postgresdb
# Default: sqlite
# Optional
DB_TYPE=

# PostgreSQL hostname
# Example: postgres
# Format: hostname
# Required when using postgresdb
DB_POSTGRESDB_HOST=

# PostgreSQL port
# Example: 5432
# Format: int
# Default: 5432
# Optional
DB_POSTGRESDB_PORT=

# PostgreSQL database name
# Example: n8n
# Format: string
# Required when using postgresdb
DB_POSTGRESDB_DATABASE=

# PostgreSQL username
# Example: n8n
# Format: string
# Required when using postgresdb
DB_POSTGRESDB_USER=

# PostgreSQL password
# Sensitive
# Format: string
# Required when using postgresdb
DB_POSTGRESDB_PASSWORD=

# Automatically remove old execution history
# Helps control database size growth
# true = enabled
# false = disabled
# Format: boolean
# Default: true
# Optional
EXECUTIONS_DATA_PRUNE=

# Maximum age of stored executions in hours
# Example: 336 = 14 days
# Format: int
# Default: 336
# Optional
EXECUTIONS_DATA_MAX_AGE=

# Maximum number of stored executions
# Oldest executions are deleted first
# Example: 10000
# Format: int
# Optional
EXECUTIONS_DATA_PRUNE_MAX_COUNT=

# Enable anonymous diagnostics and telemetry
# Recommended to disable for privacy
# true = enabled
# false = disabled
# Format: boolean
# Default: true
# Optional
N8N_DIAGNOSTICS_ENABLED=

# HTTP proxy for outgoing requests
# Example: http://proxy:3128
# Format: URL
# Optional
HTTP_PROXY=

# HTTPS proxy for outgoing requests
# Example: http://proxy:3128
# Format: URL
# Optional
HTTPS_PROXY=

# Hosts/subnets excluded from proxy usage
# Example: localhost,127.0.0.1,10.0.0.0/8
# Format: comma-separated list
# Optional
NO_PROXY=