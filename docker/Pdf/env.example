############################################################
#  Stirling-PDF Environment Variables
############################################################

# ──────────────── Basics ────────────────
# TZ -- System timezone, duh
# Format: Region/City
# Required
TZ=

# VERSION -- Tag of image version to use
# Note: Prevents accidental updates when new releases appear
# Format: 1.5.0-fat | latest | custom tag
# Default: 1.5.0-fat
# Optional
VERSION=

# ──────────────── Networking ────────────────
# PUBLIC_DOMAIN -- Public domain for user access
# Note: Used in Traefik labels
# Format: your.domain.com
# Required
PUBLIC_DOMAIN=

# ──────────────── Feature Flags ────────────────
# DISABLE_ADDITIONAL_FEATURES -- Disable optional advanced tools (like AI features, OCR extras)
# Format: bool
# Default: false (features enabled)
# Optional
DISABLE_ADDITIONAL_FEATURES=

# LANGS -- Default UI and OCR language
# Format: comma-separated language codes
# Example: en_GB | en_US,fr_FR,de_DE
# Optional
LANGS=

# ──────────────── Storage ────────────────
# SSD_SERVICE_ROOT_DIR -- Root directory on fast storage (SSD/NVMe)
# Note: Used for service data requiring high I/O performance
# such as cache, thumbnails, transcode, model cache, and other
# frequently accessed small files.
# Default: ./StirlingPDF
# Optional
SSD_SERVICE_ROOT_DIR=
